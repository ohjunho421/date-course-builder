generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id           String              @id @default(cuid())
  slug         String              @unique
  ownerToken   String              @default("")
  userId       String?
  title        String
  intro        String?
  modes        String              @default("walk")
  stops        Json
  createdAt    DateTime            @default(now())
  responses    Response[]
  participants CourseParticipant[]
  memories     CourseMemory[]

  @@index([userId])
}

// 다녀온 뒤 남기는 추억 기록 — 사진/영상(바이너리 포함) 또는 한 줄 텍스트
model CourseMemory {
  id         String   @id @default(cuid())
  courseSlug String
  kind       String // "image" | "video" | "text"
  text       String   @default("")
  mimeType   String?
  data       Bytes?
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@index([courseSlug])
}

// 코스를 받은(공유 링크로 들어온) 로그인 사용자 — "받은 코스"로 히스토리에 표시
model CourseParticipant {
  id         String   @id @default(cuid())
  courseSlug String
  userId     String
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@unique([courseSlug, userId])
  @@index([userId])
}

model Response {
  id         String   @id @default(cuid())
  courseSlug String
  name       String?
  message    String?
  picks      Json // { [stopId]: placeName }
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@index([courseSlug])
}
