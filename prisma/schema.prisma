generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  intro     String?
  modes     String   @default("walk")
  stops     Json
  createdAt DateTime @default(now())
}
